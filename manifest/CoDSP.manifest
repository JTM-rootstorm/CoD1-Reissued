# recomp_lift manifest for CoDSP.exe, Steam v1.5b, unpacked with
# tools/unpack_steam.py (see FINDINGS.md). Line based:
#
#   entry <hexva> [name]   extra function entry point
#   name  <hexva> <name>   name a function (comments in generated code)
#   probe <hexva> [name]   call recomp::Probe() on entry (runtime logs it)
#   resume <hexva>         this call/jmp abandons the current call chain
#                          (SEH, longjmp): throw GuestResume to the owning
#                          frame
#   setjmp <hexva> [name]  a setjmp function: its callers catch
#                          GuestResume, its return points become entries
#   replace <hexva> [name] src/ defines f_<VA>; the lifted body becomes
#                          f_<VA>_lifted

# SEH: the MSVC 7 CRT's __except_handler3 *calls* the __except block,
# which starts with `mov esp, [ebp-18h]` and never returns. Same code as
# Dungeon Siege's (VC6) handler, found by its byte pattern.
resume 00528277

# setjmp/longjmp (MSVC 7 CRT): the error routine 0x42E660 longjmps to
# the setjmp in 0x42FDE0 (startup: build banner, "Error during
# initialization" on a drop) or 0x430690 (e.g. disconnect). __setjmp3
# saves ebp/ebx/edi/esi/esp/return address in the jmp_buf; _longjmp
# unwinds the SEH chain, restores them and ends in `jmp [edx+14h]`.
setjmp 0052E84C __setjmp3
resume 0051CAB1

# Cinematic slot reset: also clears the stale target frame (src/cinematic.cpp).
replace 00406DA0

# Collision traces: CM_Trace, CM_BoxTrace, the body of
# CM_TransformedBoxTrace and CM_TransformedBoxTrace, and point contents
# (src/cm_trace.cpp).
replace 0041CD60
replace 0041D380
replace 0041D3B0
replace 0041D870
replace 0041A730
replace 0041A820

# pk3 reads on the host's zlib: unzOpenCurrentFile, unzReadCurrentFile and
# unzCloseCurrentFile (src/unzip.cpp).
replace 0049E6D0
replace 0049E7F0
replace 0049EAA0

# The pk3 directory scan: the central directory read with one fread per
# entry (src/unzip.cpp), and the CRT's tolower, which the file-name hash
# calls for every character (src/crt.cpp).
replace 0049DE20
replace 0051B3DD

# The game module's savegame (de)compression on the host's zlib: compress2
# and uncompress (src/zlib.cpp).
replace 00497D00
replace 0049D8A0

# libjpeg 6's float IDCT, jpeg_idct_float (src/jpeg_idct.cpp); the rest of
# libjpeg stays lifted.
replace 00519140

# CPU skinning into the tessellator, SSE versions: native (src/skinning.cpp).
replace 005070E0
replace 00507D20

# Native resolution: r_mode -1 with r_customwidth/height 0 is the desktop
# size, and the hunk is large enough for it (src/video_mode.cpp).
replace 004A5610
replace 0042A980

# Frame pacing: sleep to an exact 1/com_maxfps grid instead of the
# millisecond busy wait (src/frame_pacing.cpp).
replace 00430690

# 2D placement on wide screens (src/screen2d.cpp): the renderer's 2D
# entries (SetColor, StretchPic and its gradient, rotated and four-vertex
# forms, StretchRaw, queuing a text command), running a text command, the
# client's AdjustFrom640, the cinematic draw and the notify lines.
replace 004D42A0
replace 004D4330
replace 004D43D0
replace 004D44D0
replace 004D45B0
replace 004CCD10
replace 004D6400
replace 004CDCC0
replace 0040FED0
replace 004076F0
replace 00409130
